# The repository is PUBLIC. Everything in this file is here because committing it
# would leak an account identifier or a credential.

# The real wrangler config: carries account_id and the D1 database_id. Generated by
# following the recipe in README.md; selected with `-c` for every --remote operation.
wrangler.local.toml

# Local dev secrets.
.dev.vars
.dev.vars.*
.env
.env.*

# Miniflare / wrangler local state, including the local D1 SQLite file.
.wrangler/

# Build output from `wrangler deploy --dry-run --outdir dist`.
dist/

node_modules/

# Generated by `wrangler types` from wrangler.toml. 15k lines of runtime types,
# regenerated by `npm run typecheck`. No secrets, but no reason to carry it in a
# public diff either.
worker-configuration.d.ts
