{
  "name": "staple",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first task tracker for coding agents. SQLite workspaces, hub federation, MCP + CLI + local web UI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "staple": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "ui": "tsx src/cli.ts ui",
    "dev": "npm run build:ui && tsx src/cli.ts ui --hub --no-open",
    "dev:all": "tsx scripts/dev-ui.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/app/tsconfig.json",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "build:ui": "vite build --config src/ui/app/vite.config.ts",
    "build:package": "npm run build:ui && tsx scripts/build-package.ts",
    "pack:package": "npm run build:package && npm pack ./dist-package --pack-destination dist-package",
    "drill:npx": "tsx scripts/drill-npx.ts",
    "dev:ui": "vite --config src/ui/app/vite.config.ts",
    "site": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.39.0",
    "playwright-core": "^1.62.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
